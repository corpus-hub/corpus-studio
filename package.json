{
  "name": "corpus-studio",
  "version": "1.2.4",
  "description": "Corpus Studio \u2014 local-first scientific-literature exploration platform",
  "homepage": "https://corpushub.net",
  "author": "Jaskier <varingait@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run build:plugins && electron-vite build",
    "build:plugins": "tsx scripts/build-plugins.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "seed": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/run-seed.ts",
    "seed:fresh": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/run-seed.ts --fresh",
    "seed:stress": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/seed-stress.ts",
    "parse:citations": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/parse-citations.ts",
    "test:tabs": "tsx --test src/shared/nav.test.ts src/main/tabs.test.ts",
    "test:references": "tsx --test src/shared/referenceLabel.test.ts",
    "test:citations": "tsx --test src/main/citations/parseReferences.test.ts src/main/citations/entryFields.test.ts src/main/citations/roleRules.test.ts src/main/citations/callouts.test.ts",
    "test:refusals": "tsx --test src/main/llm/refusals.test.ts src/main/embedding/truncation.test.ts",
    "test:main": "tsx --test src/main/outlets/settings.test.ts src/main/search/sources/web-search-server.test.ts src/main/tabs-session.test.ts src/main/updater.test.ts",
    "report:references": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/citation-reference-report.ts",
    "report:citations": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/citation-parse-report.ts",
    "verify:backend": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-backend.ts",
    "verify:setup": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-setup.ts",
    "verify:resources": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-resources.ts",
    "verify:offline": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-offline.ts",
    "verify:offline:net": "bash scripts/verify-offline-net.sh",
    "verify:syncStates": "node scripts/check-sync-states.mjs",
    "verify:pluginStates": "node scripts/check-plugin-states.mjs",
    "verify:analyticsStates": "node scripts/check-analytics-states.mjs",
    "icons": "bash scripts/make-icons.sh",
    "package": "npm run payloads && npm run verify:payloads && npm run verify:licences && npm run build && node scripts/run-builder.mjs --dir",
    "dist": "npm run payloads && npm run verify:payloads && npm run verify:licences && npm run build && node scripts/run-builder.mjs",
    "dist:linux": "npm run payloads -- --platform linux-x64 && npm run verify:payloads && npm run verify:licences && npm run build && node scripts/run-builder.mjs --linux",
    "dist:win": "npm run payloads -- --platform win32-x64 && npm run verify:licences && npm run build && node scripts/run-builder.mjs --win",
    "dist:mac": "npm run payloads -- --platform darwin-x64 --platform darwin-arm64 && npm run verify:licences && npm run build && node scripts/run-builder.mjs --mac",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "CORPUS_E2E_HEADED=1 playwright test",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "relaunch": "bash scripts/relaunch.sh",
    "shot": "xvfb-run -a tsx scripts/shot.ts",
    "verify:sidecar": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-sidecar.ts",
    "verify:packaged": "bash scripts/verify-packaged.sh",
    "verify:migration": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-migration.ts",
    "verify:pipeline": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-pipeline.ts",
    "verify:vector": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-vector-search.ts",
    "verify:highlights": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-highlight-coverage.ts",
    "verify:xlsx": "tsx scripts/verify-xlsx.ts",
    "verify:outlets": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-outlets.ts",
    "verify:host": "node scripts/run-host-check.mjs",
    "verify:stage-host": "node scripts/run-stage-host-check.mjs",
    "verify:corpus": "xvfb-run -a electron scripts/run-corpus-verify.cjs",
    "payloads": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/payloads.ts",
    "verify:payloads": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-payloads.ts",
    "licences": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/gen-licences.ts",
    "verify:licences": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/gen-licences.ts --check",
    "probe:review": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/probe-review.ts",
    "corpus:process": "xvfb-run -a electron scripts/run-corpus-process.cjs",
    "rerun:works": "xvfb-run -a electron scripts/run-rerun-works.cjs",
    "repair:corpus": "xvfb-run -a electron scripts/run-repair-corpus.cjs",
    "corpus:export": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/export-analyses.ts",
    "test:units": "tsx --test src/main/llm/units.test.ts",
    "verify:updater": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-updater.ts",
    "verify:updateStates": "tsx scripts/verify-update-states.ts",
    "verify:registry": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-registry.ts",
    "docs:mcp": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/gen-mcp-docs.ts",
    "docs:mcp:check": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/gen-mcp-docs.ts --check",
    "verify:mcp": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/verify-mcp.ts",
    "trace": "ELECTRON_RUN_AS_NODE=1 electron --import tsx scripts/trace.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@napi-rs/canvas": "^0.1.100",
    "better-sqlite3": "^11.8.1",
    "electron-updater": "^6.8.9",
    "onnxruntime-node": "1.21.0",
    "pdfjs-dist": "^4.10.38",
    "tesseract.js": "^6.0.1",
    "tesseract.js-core": "^6.1.2",
    "undici": "^7.29.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@fontsource/geist-mono": "^5.1.0",
    "@fontsource/instrument-sans": "^5.1.0",
    "@playwright/test": "^1.49.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "d3": "^7.9.0",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.7",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11"
  }
}
